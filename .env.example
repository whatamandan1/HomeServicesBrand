# Frontend (src/frontend/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:5080

# Sentry (optional - error tracking)
# NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Backend - copy to src/backend/Sorted.Api/appsettings.Development.local.json
# or set as user secrets: dotnet user-secrets set "Stripe:SecretKey" "sk_test_..."

# Stripe
# Stripe__SecretKey=sk_test_...
# Stripe__WebhookSecret=whsec_...
# Stripe__SuccessUrl=http://localhost:3000/signup/success
# Stripe__CancelUrl=http://localhost:3000/signup

# Google Maps Static API (satellite imagery for garden-size suggestions at signup)
# GoogleMaps__ApiKey=...

# SendGrid
# SendGrid__ApiKey=SG....

# Background jobs (Railway - optional overrides)
# BackgroundJobs__Enabled=true
# BackgroundJobs__IntervalMinutes=60
# BackgroundJobs__TargetFutureVisits=4
