# API base URL (Railway) - no trailing slash
# Used by Next.js rewrites to proxy /api/* to the backend.
API_URL=http://localhost:5080

# Optional: call Railway directly from the browser (skip proxy).
# Leave unset in production - the proxy handles it.
# NEXT_PUBLIC_API_URL=http://localhost:5080

# Public site URL for Open Graph / metadata / sitemap
# Production: https://gardenssorted.co.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only in local/staging to show demo login hints on /login
# NEXT_PUBLIC_SHOW_DEMO_LOGIN=true

# Marketing tags (loaded only after cookie consent — see /cookies)
# GA4 measurement ID from Google Analytics → Admin → Data streams (not the raw gtag HTML)
# NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-YTCG270KXL

# UK address autocomplete on signup (server-side only — pick one provider)
# Ideal Postcodes (recommended): https://ideal-postcodes.co.uk/
IDEAL_POSTCODES_API_KEY=ak_test
# Legacy getAddress.io (optional fallback if Ideal Postcodes is unset)
# GETADDRESS_API_KEY=
