# API base URL (Railway) — no trailing slash
# Used by Next.js rewrites to proxy /api/* to the backend.
API_URL=http://localhost:5080

# Optional: call Railway directly from the browser (skip proxy).
# Leave unset in production — the proxy handles it.
# NEXT_PUBLIC_API_URL=http://localhost:5080

# Public site URL for Open Graph / metadata / sitemap
# Production: https://gardenssorted.co.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only in local/staging to show demo login hints on /login
# NEXT_PUBLIC_SHOW_DEMO_LOGIN=true
